<?xml version="1.0" encoding="utf-8"?><!--
    非法导入课程弹窗中的单项分段卡。
    仅显示课程名称和错误类别，不展示具体周数或节次值，避免信息密度过高。
-->
<com.google.android.material.listitem.ListItemLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.listitem.ListItemCardView
        android:id="@+id/invalid_course_card"
        style="@style/Widget.OpenWakeUp.ListItemCardView.Segmented"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ms_error_24"
                app:tint="?attr/colorError" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/invalid_course_name"
                    style="@style/Widget.Material3.TextView.ListItem.LabelText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/invalid_course_reason"
                    style="@style/Widget.Material3.TextView.ListItem.SupportingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorError" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.listitem.ListItemCardView>
</com.google.android.material.listitem.ListItemLayout>
