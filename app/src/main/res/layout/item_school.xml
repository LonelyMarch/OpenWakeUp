<?xml version="1.0" encoding="utf-8"?><!-- 学校条目使用 M3 ListItemLayout + 分段 ListItemCardView：同一首字母下的学校会连接成
     一张分段卡，组首/组尾形状由 Activity 绑定数据时交给组件状态机计算。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 每个首字母只在该组第一条记录之前显示一次，效果与粘性分组标题一致。 -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorPrimary"
        tools:text="A" />

    <com.google.android.material.listitem.ListItemLayout
        android:id="@+id/schoolListItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.listitem.ListItemCardView
            android:id="@+id/content"
            style="@style/Widget.OpenWakeUp.ListItemCardView.Segmented"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvName"
                    style="@style/Widget.Material3.TextView.ListItem.LabelText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="安徽师范大学" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvType"
                    style="@style/Widget.Material3.TextView.ListItem.TrailingSupportingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:maxLines="1"
                    tools:text="正方教务" />

                <ImageView
                    android:id="@+id/schoolChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ms_chevron_right_24"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.listitem.ListItemCardView>
    </com.google.android.material.listitem.ListItemLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
