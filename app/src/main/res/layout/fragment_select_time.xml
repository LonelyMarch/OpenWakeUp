<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:minWidth="280dp"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/add_course_title_select_time"
        android:textStyle="bold" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <com.openwakeup.schedule.core.designsystem.component.NumberPickerView
            android:id="@+id/wp_day"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:npv_DividerColor="?attr/colorPrimary"
            app:npv_RespondChangeOnDetached="false"
            app:npv_ShownCount="4"
            app:npv_TextColorNormal="?attr/colorOnBackground"
            app:npv_TextColorSelected="?attr/colorPrimary"
            app:npv_TextSizeNormal="14sp"
            app:npv_TextSizeSelected="14sp"
            app:npv_WrapSelectorWheel="false" />

        <com.openwakeup.schedule.core.designsystem.component.NumberPickerView
            android:id="@+id/wp_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:npv_DividerColor="?attr/colorPrimary"
            app:npv_RespondChangeOnDetached="false"
            app:npv_ShownCount="4"
            app:npv_TextColorNormal="?attr/colorOnBackground"
            app:npv_TextColorSelected="?attr/colorPrimary"
            app:npv_TextSizeNormal="14sp"
            app:npv_TextSizeSelected="14sp"
            app:npv_WrapSelectorWheel="false" />

        <com.openwakeup.schedule.core.designsystem.component.NumberPickerView
            android:id="@+id/wp_end"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:npv_DividerColor="?attr/colorPrimary"
            app:npv_RespondChangeOnDetached="false"
            app:npv_ShownCount="4"
            app:npv_TextColorNormal="?attr/colorOnBackground"
            app:npv_TextColorSelected="?attr/colorPrimary"
            app:npv_TextSizeNormal="14sp"
            app:npv_TextSizeSelected="14sp"
            app:npv_WrapSelectorWheel="false" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/DialogButtonStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/DialogButtonStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/ok"
            android:textStyle="bold" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
